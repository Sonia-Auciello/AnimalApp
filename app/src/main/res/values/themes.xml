<resources>
    <!-- Base application theme. -->
    <style name="Theme.AnimalApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorPrimaryVariant">#3F51B5</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="customColorDrawableValue">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/blue_700</item>

        <!--il folle senso dietro questa necessità mi è attualmente ancora sconosciuto-->
        <item name="colorSecondary">@color/light_accent</item>
        <item name="android:colorSecondary">?attr/colorSecondary</item>

        <item name="android:textColor">?attr/colorOnPrimary</item>

        <item name="android:itemTextAppearance">@style/myCustomMenuTextAppearance</item>

        <!-- Customize your theme here. -->

        <item name="colorOnSecondary">@color/black</item>

        <item name="colorTertiary">@color/cardview_light_background</item>
        <item name="colorOnTertiary">@color/black</item>

        <item name="android:navigationBarColor">@color/blue_700</item>


    </style>
</resources>